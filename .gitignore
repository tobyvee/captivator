# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo

# Tests
coverage/

# Env files (vinext loads them in dev and build). Secrets go in .dev.vars instead.
.env*

# Cloudflare: Wrangler state and local Worker secrets (the Unsplash access key). Commit .dev.vars.example only.
.wrangler/
.dev.vars*
!.dev.vars.example

# Claude Code: per-user settings and agent worktrees
.claude/settings.local.json
.claude/worktrees/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS and editors
.DS_Store
*.pem
.idea/
.vscode/*
!.vscode/extensions.json
